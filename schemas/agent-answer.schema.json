{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations", "toolsUsed"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "直接给用户看的中文回答，使用 [1]、[2] 引用 citations。"
    },
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source", "verified"],
        "properties": {
          "title": { "type": "string" },
          "source": { "type": "string" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "nameCards": {
      "type": "array",
      "maxItems": 6,
      "description": "推荐或比较姓名时返回的结构化候选卡；纯方法问答可以为空数组。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pinyin", "source", "quote", "meaning", "verified"],
        "properties": {
          "name": { "type": "string" },
          "pinyin": { "type": "string" },
          "source": { "type": "string" },
          "quote": { "type": "string" },
          "meaning": { "type": "string" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "toolsUsed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["file_find", "file_grep", "file_read"]
      }
    }
  }
}
