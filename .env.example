# 选择 codex 或 openai。默认 codex。
JIAMING_PROVIDER=codex

# 通用服务设置
JIAMING_HOST=127.0.0.1
JIAMING_PORT=4318
JIAMING_OPEN_BROWSER=true
# 仅在可信局域网中启用；启用后其他设备可以调用你的模型额度。
JIAMING_ALLOW_LAN_AGENT=false

# Codex 订阅模式：凭据由 Codex CLI 自己管理，不要写入本文件。
JIAMING_CODEX_MODEL=gpt-5.6-terra
JIAMING_CODEX_REASONING=low
JIAMING_CODEX_TIMEOUT_MS=240000

# OpenAI 兼容模式：将 JIAMING_PROVIDER 改为 openai 后生效。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_STYLE=responses
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_TOOL_ROUNDS=8
