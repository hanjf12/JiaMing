# 选择 codex 或 third-party。两种模式都由 Codex CLI Agent 执行。
JIAMING_PROVIDER=codex

# 通用服务设置
JIAMING_HOST=127.0.0.1
JIAMING_PORT=4318
JIAMING_OPEN_BROWSER=true
# 仅在可信局域网中启用；启用后其他设备可以调用你的模型额度。
JIAMING_ALLOW_LAN_AGENT=false

# Codex 订阅模式：凭据由 Codex CLI 自己管理，不要写入本文件。
JIAMING_CODEX_MODEL=gpt-5.6-terra
JIAMING_CODEX_REASONING=low
JIAMING_CODEX_TIMEOUT_MS=240000

# 第三方模型：将 JIAMING_PROVIDER 改为 third-party 后生效。
# 接口必须兼容 OpenAI Responses API 和函数/工具调用。
JIAMING_THIRD_PARTY_NAME=第三方模型
JIAMING_THIRD_PARTY_BASE_URL=
JIAMING_THIRD_PARTY_MODEL=
JIAMING_THIRD_PARTY_API_KEY_ENV=OPENAI_API_KEY
JIAMING_THIRD_PARTY_REASONING=low
JIAMING_THIRD_PARTY_TIMEOUT_MS=240000
OPENAI_API_KEY=
