{
  "name": "jiaming-baby-names",
  "version": "1.0.0",
  "description": "中文宝宝起名与经典原文检索工具，支持 Codex 订阅和 OpenAI 兼容模型。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:lan": "node src/server.mjs --lan",
    "wiki:build": "node scripts/build-wiki.mjs",
    "wiki:lint": "node scripts/lint-wiki.mjs",
    "wiki:check": "npm run wiki:build && npm run wiki:lint",
    "corpus:sync": "node scripts/sync-corpus.mjs",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:status": "node scripts/corpus-status.mjs",
    "knowledge": "node scripts/knowledge.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run wiki:lint && npm test"
  },
  "keywords": [
    "chinese-name",
    "baby-name",
    "rag",
    "codex",
    "openai-compatible"
  ]
}
